# eBay API Credentials
# Get your credentials at: https://developer.ebay.com/
EBAY_APP_ID=your_app_id_here
EBAY_CERT_ID=your_cert_id_here
EBAY_DEV_ID=your_dev_id_here

# PriceCharting API (optional)
# Get your API key at: https://www.pricecharting.com/api-documentation
PRICECHARTING_API_KEY=your_api_key_here

# Configuration
DEFAULT_DISCOUNT_THRESHOLD=50
CACHE_EXPIRY_HOURS=48
MAX_RESULTS=50
